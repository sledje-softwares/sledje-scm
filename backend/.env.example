# ---------------------------------------------------------------------------
# Sledje backend environment
# Copy to .env and fill in. See docs/09-operations.md for what reads each key.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Postgres ---
# NOTE: docker-compose maps Postgres to host port 5433, not 5432.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/sledje

# Used by docker-compose.yml only (not read by application code).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Auth ---
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# --- NATS (JetStream required) ---
NATS_URL=nats://localhost:4222

# --- Realtime ---
# Socket.IO CORS origin. Defaults to "*" when unset.
CLIENT_ORIGIN=http://localhost:3000

# --- Email (SMTP_* is the live path, used by modules/auth/email.service.js) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Second, currently-unused mail config read by utils/email.js.
# Leave blank unless you wire that file up.
MAIL_USER=
MAIL_PASS=

# --- Delivery confirmation codes (docs/15-delivery-confirmation.md) ---
# 32 bytes of hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_CODE_KEY=

# --- Google Drive (optional, for /api/upload/profile-picture) ---
# Also requires a service-account.json in the backend working directory.
# NOTE: uploaded files are made publicly readable.
DRIVE_FOLDER_ID=

# --- Payments (optional; the webhook route is not currently mounted) ---
RAZORPAY_WEBHOOK_SECRET=

# --- Settlement worker (optional) ---
# weekly | monthly. Overridden by the --period CLI flag.
SETTLEMENT_PERIOD=weekly
