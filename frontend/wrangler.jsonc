{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sledje-scm",
  "compatibility_date": "2026-09-08",
  // Static assets only — no Worker script. `vite build` already writes to
  // build/ (pinned in vite.config.js, not Vite's default dist/).
  "assets": {
    "directory": "./build",
    // react-router-dom does client-side routing: a deep link like
    // /retailer/pos has no matching file, so unmatched paths must resolve to
    // the SPA shell rather than 404 — the shell then reads the URL itself.
    "not_found_handling": "single-page-application"
  }
}
