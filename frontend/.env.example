# ---------------------------------------------------------------------------
# Sledje frontend environment
# Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Base URL of the backend. Read by src/api.js as import.meta.env.VITE_API_URL,
# with a fallback to the deployed Render host when unset. Only variables
# prefixed VITE_ are exposed to the client bundle.
VITE_API_URL=http://localhost:5000
